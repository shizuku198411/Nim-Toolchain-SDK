#!/usr/bin/env bash
set -euo pipefail

cd /project

missing=0

command -v /home/workshop/.local/bin/nim >/dev/null || missing=1
command -v /home/workshop/.local/bin/nimble >/dev/null || missing=1
command -v /home/workshop/.local/bin/nimpretty >/dev/null || missing=1
command -v /home/workshop/.local/bin/nimgrep >/dev/null || missing=1
command -v /home/workshop/.local/bin/nim-gdb >/dev/null || missing=1

if [ "$missing" -eq 0 ]; then
  workshopctl set-health okay
else
  workshopctl set-health waiting "Environment is still missing toolchain artifacts"
fi
